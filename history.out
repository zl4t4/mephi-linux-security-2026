    1  groupadd students
    2  useradd -u 1234 -G students -m user1
    3  passwd user1
    4  chage -M 90 user1
    5  id user1
    6  chage -l user1
    7  find / -perm -4000 -type f 2>/dev/null | tee ~/setuid-files.out
    8  ps -eo pid,ruid,euid,cmd | awk '$2 != $3 && $3 == 0' | tee ~setuid-processes.out
    9  cp /usr/bin/cat /home/user1/mycat
   10  chown root:root /home/user1/mycat
   11  chmod 4755 /home/user1/mycat
   12  ls -l /home/user1/mycat
   13  su - user1 -c 'cat /etc/shadox'
   14  su - user1 -c 'cat /etc/shadow'
   15  su - user1 -c '/home/user1/mycat /etc/shadow'
   16  cp /usr/bin/chown /home/user1/mychown
   17  setcap cap_chown+ep /home/user1/mychown
   18  getcap /home/user1/mychown
   19  su - user1 -c 'touch /home/user1/testfile'
   20  su - user1 -c 'chown nobody /home/user1/testfile'
   21  su - user1 -c '/home/user1/mychown nobody /home/user1/testfile'
   22  ls -l /home/user1/testfile
   23  which date timedatectl
   24  visudo
   25  which date timedatectl
   26  jobs
   27  kill %1
   28  visudo
   29  jobs
   30  fg
   31  user1 ALL=(root) NOPASSWD: /usr/bin/date -s *, /usr/bin/timedatectl set-time /usr/bin/
   32  jobs
   33  fg
   34  visudo
   35  su - user1 -c "sudo date -s '2026-10-10 11:53:00'"
   36  echo "M265927"
   37  history > ~/history.out
